---
/**
 * Neurocapy, the site's mascot: a capybara with a sprig of dendrites.
 * Drawn for this site (CC BY 4.0). `pose="head"` gives a round badge for the logo and favicon.
 */
interface Props {
  size?: number | string;
  pose?: 'full' | 'head';
  title?: string;
  class?: string;
}
const { size = 160, pose = 'full', title = 'Neurocapy, the NeuroCapybara mascot', class: cls } = Astro.props;
// An empty title means the picture is decorative: hide it from screen readers.
const role = title ? 'img' : undefined;
const label = title || undefined;
const hidden = title ? undefined : 'true';
const fur = '#a8724e';
const furDark = '#8a5a3b';
const belly = '#c49470';
const legs = '#7a4e33';
const ink = '#2b1d16';
const spark = '#b69cff';
---

{
  pose === 'head' ? (
    <svg class={cls} width={size} height={size} viewBox="0 0 64 64" role={role} aria-label={label} aria-hidden={hidden}>
      {title && <title>{title}</title>}
      <circle cx="32" cy="32" r="31" fill="#1c2538" />
      <path d="M40 18 C 34 12, 18 12, 12 20 C 7 27, 7 37, 11 42 C 15 47, 25 49, 33 47 C 42 45, 48 39, 48 31 C 48 25, 45 21, 40 18 Z" fill={fur} />
      <circle cx="40" cy="17" r="4.2" fill={furDark} />
      <circle cx="29" cy="24" r="2.6" fill={ink} />
      <circle cx="29.8" cy="23.2" r="0.8" fill="#fff" />
      <ellipse cx="12.5" cy="28" rx="1.6" ry="1.1" fill={ink} />
      <path d="M13 40 q 4 2.6 8 0.4" stroke={ink} stroke-width="1.4" fill="none" stroke-linecap="round" />
      <g stroke={spark} stroke-width="1.8" stroke-linecap="round" fill="none">
        <path d="M27 14 L 25 8 M25 8 L 21 5 M25 8 L 26.5 3.5" />
      </g>
      <g fill={spark}>
        <circle cx="21" cy="5" r="1.6" />
        <circle cx="26.5" cy="3.5" r="1.6" />
      </g>
    </svg>
  ) : (
    <svg class={cls} width={size} viewBox="0 0 240 180" role={role} aria-label={label} aria-hidden={hidden}>
      {title && <title>{title}</title>}
      <ellipse cx="128" cy="166" rx="96" ry="8" fill="currentColor" opacity="0.12" />
      <rect x="86" y="128" width="20" height="34" rx="9" fill={legs} />
      <rect x="182" y="124" width="20" height="38" rx="9" fill={legs} />
      <path d="M66 96 C 66 58, 108 44, 150 44 C 196 44, 226 66, 226 104 C 226 136, 204 152, 170 152 L 104 152 C 80 152, 66 128, 66 96 Z" fill={fur} />
      <path d="M92 132 C 118 146, 170 148, 206 130 C 200 146, 184 152, 168 152 L 104 152 C 98 152, 94 146, 92 132 Z" fill={belly} opacity="0.75" />
      <rect x="110" y="132" width="18" height="30" rx="8.5" fill={furDark} />
      <rect x="204" y="118" width="16" height="40" rx="8" fill={furDark} />
      <path d="M112 50 C 104 34, 66 26, 40 38 C 20 47, 12 66, 16 84 C 20 102, 40 112, 66 110 C 94 108, 116 96, 120 78 C 122 66, 118 58, 112 50 Z" fill={fur} />
      <path d="M16 84 C 22 100, 42 110, 66 110 C 52 112, 30 106, 20 96 Z" fill={furDark} opacity="0.5" />
      <ellipse cx="106" cy="40" rx="10" ry="9" fill={furDark} />
      <ellipse cx="107" cy="41" rx="5" ry="4.5" fill={legs} />
      <circle cx="78" cy="56" r="5.2" fill={ink} />
      <circle cx="79.6" cy="54.4" r="1.6" fill="#fff" />
      <path d="M70 47 q 8 -5 16 0" stroke={furDark} stroke-width="2.4" fill="none" stroke-linecap="round" />
      <ellipse cx="22" cy="62" rx="3.4" ry="2.4" fill={ink} />
      <path d="M22 92 q 10 6 20 1" stroke={ink} stroke-width="2.4" fill="none" stroke-linecap="round" />
      <circle cx="58" cy="78" r="6" fill="#e3876b" opacity="0.35" />
      <g stroke={spark} stroke-width="3" stroke-linecap="round" fill="none">
        <path d="M72 34 L 66 18 M66 18 L 56 10 M66 18 L 70 6 M60 13 L 52 15" />
      </g>
      <g fill={spark}>
        <circle cx="56" cy="10" r="3.4" />
        <circle cx="70" cy="6" r="3.4" />
        <circle cx="52" cy="15" r="2.6" />
      </g>
    </svg>
  )
}
