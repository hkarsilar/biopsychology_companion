---
/**
 * Neurotransmitter cards: filter by effect, then turn a card over for its receptors,
 * clearance, drugs and a fact. The point to take away: the receptor decides the effect.
 *
 * Usage: <TransmitterCards />  or  <TransmitterCards ids={['acetylcholine', 'gaba']} title="…" />
 */
import { transmitters, effectLabel, type TransmitterEffect } from '../../data/transmitters';

interface Props {
  id?: string;
  title?: string;
  /** Show only these transmitters, in this order */
  ids?: string[];
}
const { id = 'transmitter-cards', title = 'Transmitter cards', ids } = Astro.props;
const list = ids ? ids.map((x) => transmitters.find((t) => t.id === x)).filter((t) => t !== undefined) : transmitters;
const symbol: Record<TransmitterEffect, string> = { excitatory: '+', inhibitory: '−', depends: '±' };
const filters: [string, string][] = [
  ['all', 'All'],
  ['excitatory', '+ Excitatory'],
  ['inhibitory', '− Inhibitory'],
  ['depends', '± Depends on the receptor'],
];
---

<section class="tx" id={id} aria-labelledby={`${id}-title`}>
  <div class="tx-head">
    <h3 id={`${id}-title`}>{title}</h3>
    <div class="tx-filter" role="group" aria-label="Show transmitters that are">
      {filters.map(([f, label]) => <button type="button" class="tx-f" data-filter={f} aria-pressed={f === 'all' ? 'true' : 'false'}>{label}</button>)}
    </div>
    <p class="tx-count" aria-live="polite">Showing all {list.length}. Turn a card over to see its receptors and drugs.</p>
  </div>
  <ul class="tx-grid">
    {
      list.map((t) => (
        <li class="tx-card" data-effect={t.effect}>
          <div class="face front" id={`${id}-${t.id}-front`}>
            <p class="family">{t.family}</p>
            <h4>{t.name}</h4>
            <p class={`badge ${t.effect}`}>
              <span aria-hidden="true">{symbol[t.effect]}</span> {effectLabel[t.effect]}
            </p>
            <p class="tagline">{t.tagline}</p>
            <ul class="chips" aria-label={`${t.name} receptors`}>
              {t.receptors.map((r) => (
                <li class={r.does}>
                  <span aria-hidden="true">{r.does === 'excites' ? '+' : '−'}</span> {r.name}
                  <span class="visually-hidden">: {r.does}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="face back" id={`${id}-${t.id}-back`} hidden>
            <p class="family">{t.name}</p>
            <dl>
              <dt>Receptors</dt>
              <dd>
                <ul class="rlist">
                  {t.receptors.map((r) => (
                    <li>
                      <b>{r.name}</b> <span class="kind">{r.kind}</span>{' '}
                      <span class={`does ${r.does}`}>
                        <span aria-hidden="true">{r.does === 'excites' ? '+' : '−'}</span> {r.does}
                      </span>
                      <br />
                      {r.note}
                    </li>
                  ))}
                </ul>
              </dd>
              <dt>Where</dt>
              <dd>{t.where}</dd>
              <dt>Cleared by</dt>
              <dd>{t.clearance}</dd>
              <dt>Drugs</dt>
              <dd>
                <ul class="dlist">
                  {t.drugs.map((d) => (
                    <li>
                      <b>{d.name}</b> {d.action}
                    </li>
                  ))}
                </ul>
              </dd>
              <dt>Did you know?</dt>
              <dd>{t.fact}</dd>
            </dl>
          </div>
          <button type="button" class="flip" aria-expanded="false" aria-controls={`${id}-${t.id}-back`}>
            <span class="lbl">Turn over</span>
            <span class="visually-hidden"> the {t.name} card</span>
          </button>
        </li>
      ))
    }
  </ul>
</section>

<script>
  document.querySelectorAll<HTMLElement>('section.tx').forEach((box) => {
    const cards = [...box.querySelectorAll<HTMLElement>('.tx-card')];
    const count = box.querySelector<HTMLElement>('.tx-count')!;
    const names: Record<string, string> = { excitatory: 'excitatory', inhibitory: 'inhibitory', depends: 'that depend on the receptor' };
    box.querySelectorAll<HTMLButtonElement>('.tx-f').forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.filter ?? 'all';
        box.querySelectorAll('.tx-f').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        let n = 0;
        for (const c of cards) {
          const show = f === 'all' || c.dataset.effect === f;
          c.hidden = !show;
          if (show) n++;
        }
        count.textContent = f === 'all' ? `Showing all ${n}.` : `Showing ${n} ${names[f]}.`;
      }),
    );
    cards.forEach((c) => {
      const btn = c.querySelector<HTMLButtonElement>('.flip')!;
      const front = c.querySelector<HTMLElement>('.front')!;
      const back = c.querySelector<HTMLElement>('.back')!;
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', String(open));
        front.hidden = open;
        back.hidden = !open;
        btn.querySelector('.lbl')!.textContent = open ? 'Turn back' : 'Turn over';
        c.classList.remove('turned');
        void c.offsetWidth;
        c.classList.add('turned');
      });
    });
  });
</script>

<style>
  .tx {
    margin: 1.5rem 0;
  }
  .tx-head h3 {
    margin: 0 0 0.6rem;
  }
  .tx-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tx-f {
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    min-height: 2.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .tx-f[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .tx-count {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0.6rem 0 0.8rem;
  }
  .tx-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
    align-items: start;
  }
  .tx-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.05rem 0.9rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    perspective: 900px;
  }
  .tx-card[hidden] {
    display: none;
  }
  .tx-card[data-effect='excitatory'] {
    border-top: 4px solid var(--excite);
  }
  .tx-card[data-effect='inhibitory'] {
    border-top: 4px solid var(--inhibit);
  }
  .tx-card[data-effect='depends'] {
    border-top: 4px solid var(--accent);
  }
  .tx-card.turned .face:not([hidden]) {
    animation: turn 0.35s ease-out;
  }
  @keyframes turn {
    from {
      transform: rotateY(80deg);
      opacity: 0.2;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  .face p {
    margin: 0;
  }
  .family {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .front h4 {
    margin: 0.15rem 0 0.4rem;
    font-size: 1.3rem;
  }
  .badge {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    margin-bottom: 0.55rem !important;
  }
  .badge.excitatory {
    color: var(--excite);
  }
  .badge.inhibitory {
    color: var(--inhibit);
  }
  .badge.depends {
    color: var(--accent);
  }
  .tagline {
    font-size: 0.95rem;
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 0.65rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .chips li {
    margin: 0;
    font-size: 0.8rem;
    padding: 0.08rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface-2);
  }
  .chips li.excites span[aria-hidden],
  .does.excites {
    color: var(--excite);
    font-weight: 700;
  }
  .chips li.inhibits span[aria-hidden],
  .does.inhibits {
    color: var(--inhibit);
    font-weight: 700;
  }
  .back dl {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
  }
  .back dt {
    font-weight: 700;
    margin-top: 0.55rem;
  }
  .back dd {
    margin: 0.1rem 0 0;
  }
  .back ul {
    padding-left: 1.1rem;
    margin: 0.15rem 0 0;
  }
  .back li {
    margin: 0.2rem 0;
  }
  .kind {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .flip {
    align-self: flex-start;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    min-height: 2.4rem;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--accent);
    background: transparent;
    color: var(--accent);
    cursor: pointer;
  }
  .flip:hover {
    background: var(--accent-soft);
  }
</style>
