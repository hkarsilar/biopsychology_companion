---
/**
 * "Predict" step: students commit to an answer before running the simulation.
 * The answer is revealed only after they choose, with a nudge to go and check.
 */
interface Props {
  question: string;
  options: string[];
  answer: number;
  explain: string;
  /** id of the simulation to point to after answering */
  sim?: string;
}
const { question, options, answer, explain, sim } = Astro.props;
---

<div class="predict" data-answer={answer}>
  <p class="eyebrow">Predict first</p>
  <p class="q">{question}</p>
  <div class="opts" role="group" aria-label="Your prediction">
    {options.map((o, i) => <button type="button" class="opt" data-i={i}>{o}</button>)}
  </div>
  <div class="reveal" hidden aria-live="polite">
    <p class="verdict"></p>
    <p>{explain}</p>
    {sim && <p><a href={`#${sim}`}>Now check it in the simulation ↓</a></p>}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.predict').forEach((box) => {
    const answer = Number(box.dataset.answer);
    const reveal = box.querySelector<HTMLElement>('.reveal')!;
    const verdict = box.querySelector<HTMLElement>('.verdict')!;
    const opts = [...box.querySelectorAll<HTMLButtonElement>('.opt')];
    opts.forEach((b) =>
      b.addEventListener('click', () => {
        const i = Number(b.dataset.i);
        opts.forEach((o, j) => {
          o.setAttribute('aria-pressed', String(o === b));
          o.classList.toggle('right', j === answer);
          o.classList.toggle('wrong', o === b && j !== answer);
        });
        verdict.textContent = i === answer ? 'Good prediction.' : 'Interesting guess. Here is what actually happens:';
        reveal.hidden = false;
      }),
    );
  });
</script>

<style>
  .predict {
    background: var(--surface);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    margin: 1.75rem 0;
  }
  .q {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .opts {
    display: grid;
    gap: 0.5rem;
  }
  .opt {
    font: inherit;
    text-align: left;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-s);
    padding: 0.6rem 0.85rem;
    cursor: pointer;
  }
  .opt:hover {
    border-color: var(--accent);
  }
  .opt.right {
    border-color: var(--good);
  }
  .opt.wrong {
    border-color: var(--bad);
  }
  .reveal {
    margin-top: 0.9rem;
  }
  .verdict {
    font-weight: 700;
  }
</style>
