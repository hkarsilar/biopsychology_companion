---
import { url } from '../../lib/url';

interface Props {
  id?: string;
  preset?: string;
  predict?: boolean;
  present?: boolean;
}
const { id = 'resting-potential-sim', preset = 'potassium', predict = false, present = false } = Astro.props;
---

<nc-resting-potential id={id} class="bleed" preset={preset} predict={predict ? '' : undefined} present={present ? '' : undefined} lab-href={url('/lab/resting-potential/')}>
  <noscript><p class="callout">This simulation needs JavaScript. The lesson text still explains every step.</p></noscript>
</nc-resting-potential>

<script>
  import '../../sims/resting-potential/element';
</script>
